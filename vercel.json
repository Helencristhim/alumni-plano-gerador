{
  "version": 2,
  "github": {
    "silent": true
  },
  "buildCommand": "node scripts/build-lesson-counts.js || true; python3 scripts/check_lesson_integrity.py || true; node scripts/check_audiomap_syntax.js || true",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/professor/daniela-feitoza.html",
      "destination": "/professor/daniela-feitoza-v2.html",
      "permanent": true
    },
    {
      "source": "/aluno/daniela-feitoza.html",
      "destination": "/aluno/daniela-feitoza-v2.html",
      "permanent": true
    },
    {
      "source": "/professor/daniela-feitozaV2.html",
      "destination": "/professor/daniela-feitoza-v2.html",
      "permanent": true
    },
    {
      "source": "/aluno/daniela-feitozaV2.html",
      "destination": "/aluno/daniela-feitoza-v2.html",
      "permanent": true
    },
    {
      "source": "/professor/percival-jr.html",
      "destination": "/professor/percival-jr-v2.html",
      "permanent": true
    },
    {
      "source": "/aluno/percival-jr.html",
      "destination": "/aluno/percival-jr-v2.html",
      "permanent": true
    },
    {
      "source": "/professor/percival-jrV2.html",
      "destination": "/professor/percival-jr-v2.html",
      "permanent": true
    },
    {
      "source": "/aluno/percival-jrV2.html",
      "destination": "/aluno/percival-jr-v2.html",
      "permanent": true
    }
  ],
  "functions": {
    "api/perfil-360.js": {
      "maxDuration": 800
    },
    "api/gerar-plano.js": {
      "maxDuration": 300
    },
    "api/assistente.js": {
      "maxDuration": 300
    },
    "api/gerar-temas.js": {
      "maxDuration": 800
    },
    "api/save-perfil.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
