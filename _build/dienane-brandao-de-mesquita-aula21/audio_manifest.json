 },
 {
  "text": "Dienane, the new coworker arrives at nine. I need to meet him at the reception. What does he look like?",
  "voice": "arthur",
  "file": "a21_dienane_the_new_coworker_arrives_at_nine_i_need.mp3"
 },
 {
  "text": "His name is Paulo. He is tall and slim.",
  "voice": "ellen",
  "file": "a21_his_name_is_paulo_he_is_tall_and_slim.mp3"
 },
 {
  "text": "OK, tall and slim. And his hair?",
  "voice": "arthur",
  "file": "a21_ok_tall_and_slim_and_his_hair.mp3"
 },
 {
  "text": "He has short curly hair, and he has a beard.",
  "voice": "ellen",
  "file": "a21_he_has_short_curly_hair_and_he_has_a_beard.mp3"
 },
 {
  "text": "A beard. Does he wear glasses?",
  "voice": "arthur",
  "file": "a21_a_beard_does_he_wear_glasses.mp3"
 },
 {
  "text": "Yes, he wears glasses. And he has a big smile!",
  "voice": "ellen",
  "file": "a21_yes_he_wears_glasses_and_he_has_a_big_smile.mp3"
 },
 {
  "text": "Great, now I can find him. I will take him to your office at nine thirty.",
  "voice": "arthur",
  "file": "a21_great_now_i_can_find_him_i_will_take_him_to_your.mp3"
 },
 {
  "text": "Perfect. Thank you, Marcos!",
