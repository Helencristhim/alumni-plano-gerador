 {
  "text": "In my view, local teams are faster.",
  "voice": "ellen",
  "file": "a28_in_my_view_local_teams_are_faster.mp3"
 },
 {
  "text": "Really? That's interesting.",
  "voice": "arthur",
  "file": "a28_really_that_s_interesting.mp3"
 },
 {
  "text": "In my view, we should centralize purchasing.",
  "voice": "ellen",
  "file": "a28_in_my_view_we_should_centralize_purchasing.mp3"
 },
 {
  "text": "I think it is the best option.",
  "voice": "arthur",
