 },
 {
  "text": "Voy a viajar a Chile.",
  "voice": "ellen",
  "file": "a9_voy_a_viajar_a_chile.mp3"
 },
 {
  "text": "¿Qué vas a hacer en las vacaciones?",
  "voice": "arthur",
  "file": "a9_que_vas_a_hacer_en_las_vacaciones.mp3"
 },
 {
  "text": "Pablo va a aprender portugués.",
  "voice": "ellen",
  "file": "a9_pablo_va_a_aprender_portugues.mp3"
 },
 {
  "text": "Vamos a reservar el hotel.",
  "voice": "arthur",
  "file": "a9_vamos_a_reservar_el_hotel.mp3"
 },
 {
  "text": "Edineide, ¿qué vas a hacer en las próximas vacaciones?",
  "voice": "arthur",
  "file": "a9_edineide_que_vas_a_hacer_en_las_proximas_vacacio.mp3"
 },
 {
  "text": "Todavía no sé. Quiero conocer Chile, Argentina y España.",
  "voice": "ellen",
  "file": "a9_todavia_no_se_quiero_conocer_chile_argentina_y_e.mp3"
 },
 {
  "text": "¡Ven a Madrid! ¿Vas a viajar con tu familia?",
  "voice": "arthur",
  "file": "a9_ven_a_madrid_vas_a_viajar_con_tu_familia.mp3"
 },
 {
  "text": "Creo que sí. Primero voy a hablar con mi familia.",
  "voice": "ellen",
  "file": "a9_creo_que_si_primero_voy_a_hablar_con_mi_familia.mp3"
 },
 {
  "text": "En Madrid vamos a visitar una bodega. ¿Y el vuelo?",
  "voice": "arthur",
  "file": "a9_en_madrid_vamos_a_visitar_una_bodega_y_el_vuelo.mp3"
 },
 {
  "text": "Voy a buscar un vuelo barato y voy a reservar el hotel.",
  "voice": "ellen",
  "file": "a9_voy_a_buscar_un_vuelo_barato_y_voy_a_reservar_el.mp3"
 },
 {
  "text": "Compra el billete con tiempo. ¡Es más barato!",
  "voice": "arthur",
  "file": "a9_compra_el_billete_con_tiempo_es_mas_barato.mp3"
 },
 {
  "text": "Buena idea. ¿Y tú? ¿Cuál es tu plan para el año que viene?",
  "voice": "ellen",
  "file": "a9_buena_idea_y_tu_cual_es_tu_plan_para_el_ano_que.mp3"
 },
 {
  "text": "Voy a aprender portugués. ¿Y tu meta?",
  "voice": "arthur",
  "file": "a9_voy_a_aprender_portugues_y_tu_meta.mp3"
 },
 {
  "text": "Voy a hablar español en una entrevista. ¡Esa es mi meta!",
  "voice": "ellen",
  "file": "a9_voy_a_hablar_espanol_en_una_entrevista_esa_es_mi.mp3"
 },
 {
  "text": "Voy a reservar el hotel.",
  "voice": "ellen",
  "file": "a9_voy_a_reservar_el_hotel.mp3"
 },
 {
  "text": "Mi meta es hablar español.",
  "voice": "arthur",
  "file": "a9_mi_meta_es_hablar_espanol.mp3"
 },
 {
  "text": "El año que viene voy a conocer Argentina.",
  "voice": "ellen",
  "file": "a9_el_ano_que_viene_voy_a_conocer_argentina.mp3"
 },
 {
  "text": "Hola, soy Lucía. En diciembre voy a ir a Buenos Aires con mi marido. Vamos a estar diez días. Vamos a conocer la ciudad y vamos a ver un espectáculo de tango. Ya tengo el billete de avión. ¡Estoy muy contenta!",
  "voice": "ellen",
  "file": "a9_listening1.mp3"
 },
 {
  "text": "Hola, Edineide, soy Pablo. Te cuento mis planes para el año que viene. En el trabajo, voy a coordinar un proyecto nuevo con un banco. Y en mi vida personal, voy a aprender portugués. ¡Y voy a visitar São Paulo! ¿Cuáles son tus planes?",
  "voice": "arthur",
  "file": "a9_listening2.mp3"
 },
 {
  "text": "Pablo pregunta por las vacaciones. Edineide quiere conocer Chile, Argentina y España. Primero va a hablar con su familia. Después va a buscar un vuelo barato. Pablo dice: «Compra el billete con tiempo». Al final, Edineide habla de su meta.",
  "voice": "ellen",
  "file": "pc_order_l9.mp3"
 },
