 },
 {
  "text": "Hola, soy Carmen, del club. Mis deportes son la carrera y la natación. La carrera es en el parque. La natación es en la piscina del club. El gimnasio no es para mí.",
  "voice": "ellen",
  "file": "a2_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. Mañana, la carrera es a las siete. Después, el CrossFit es en el gimnasio del club. Las zapatillas nuevas son perfectas para la carrera. ¡Hasta mañana!",
  "voice": "arthur",
  "file": "a2_listening2.mp3"
 },
