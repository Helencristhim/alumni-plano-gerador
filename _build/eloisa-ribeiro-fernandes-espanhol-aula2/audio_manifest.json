 {
  "text": "Hola, Eloisa. ¿Cuál es tu deporte?",
  "voice": "arthur",
  "file": "a2_hola_eloisa_cual_es_tu_deporte.mp3"
 },
 {
  "text": "Mi deporte es la carrera.",
  "voice": "ellen",
  "file": "a2_mi_deporte_es_la_carrera.mp3"
 },
 {
  "text": "¡Muy bien! ¿Y el CrossFit?",
  "voice": "arthur",
  "file": "a2_muy_bien_y_el_crossfit.mp3"
 },
 {
  "text": "Sí, el CrossFit también. Es en el gimnasio.",
  "voice": "ellen",
  "file": "a2_si_el_crossfit_tambien_es_en_el_gimnasio.mp3"
 },
 {
  "text": "¿Y la natación?",
  "voice": "arthur",
  "file": "a2_y_la_natacion.mp3"
 },
 {
  "text": "Sí. La piscina de mi gimnasio es grande.",
  "voice": "ellen",
  "file": "a2_si_la_piscina_de_mi_gimnasio_es_grande.mp3"
 },
 {
  "text": "¡Tres deportes! ¿Y las zapatillas?",
  "voice": "arthur",
  "file": "a2_tres_deportes_y_las_zapatillas.mp3"
 },
 {
  "text": "Las zapatillas son nuevas. Son de Nueva York.",
  "voice": "ellen",
  "file": "a2_las_zapatillas_son_nuevas_son_de_nueva_york.mp3"
 },
 {
  "text": "¡Qué bonitas! Mañana, la carrera es a las siete.",
  "voice": "arthur",
  "file": "a2_que_bonitas_manana_la_carrera_es_a_las_siete.mp3"
 },
 {
  "text": "¡Perfecto! Hasta mañana.",
