 },
 {
  "text": "Excuse me. Where does the bus number twelve stop?",
  "voice": "arthur",
  "file": "a4_excuse_me_where_does_the_bus_number_twelve_stop.mp3"
 },
 {
  "text": "Right here, on this corner. Are you going to the sports center?",
  "voice": "ellen",
  "file": "a4_right_here_on_this_corner_are_you_going_to_the_s.mp3"
 },
 {
  "text": "Yes. When does it come?",
  "voice": "arthur",
  "file": "a4_yes_when_does_it_come.mp3"
 },
 {
  "text": "Every ten minutes. It's a short trip. The center is near the library.",
  "voice": "ellen",
  "file": "a4_every_ten_minutes_it_s_a_short_trip_the_center_i.mp3"
 },
 {
  "text": "What does a ticket cost?",
  "voice": "arthur",
  "file": "a4_what_does_a_ticket_cost.mp3"
 },
 {
  "text": "Two dollars, and you need coins. The driver doesn't give change.",
  "voice": "ellen",
  "file": "a4_two_dollars_and_you_need_coins_the_driver_doesn.mp3"
 },
 {
  "text": "Thank you. I am new here and I don't want to be lost.",
  "voice": "arthur",
  "file": "a4_thank_you_i_am_new_here_and_i_don_t_want_to_be_l.mp3"
 },
 {
  "text": "Don't worry. I take the same bus. Come with me and I show you the stop.",
  "voice": "ellen",
  "file": "a4_don_t_worry_i_take_the_same_bus_come_with_me_and.mp3"
 },
 {
  "text": "Excuse me, where is the bus stop?",
  "voice": "ellen",
  "file": "a4_excuse_me_where_is_the_bus_stop.mp3"
 },
 {
  "text": "When does the next bus come?",
  "voice": "arthur",
  "file": "a4_when_does_the_next_bus_come.mp3"
 },
 {
  "text": "Is it near here?",
  "voice": "ellen",
  "file": "a4_is_it_near_here.mp3"
 },
 {
  "text": "I am lost. Can you help me?",
  "voice": "arthur",
  "file": "a4_i_am_lost_can_you_help_me.mp3"
 },
 {
  "text": "Good morning. This is the bus number twelve to Grand Avenue. Our next stop is Fifth Street. Please have your ticket ready. One ticket is two dollars and we only take coins. After Fifth Street we stop at the public library, and then at the city sports center. The bus doesn't stop at the park today because the street is closed. If you need help, please talk to me. Thank you.",
  "voice": "arthur",
  "file": "a4_listening1.mp3"
 },
 {
  "text": "Hi Bruno, this is Coach Parker. Where are you? The practice starts in ten minutes. Listen: when you leave the bus, you see a big blue building. That is the library. Don't go left. Go right, and walk two minutes. The sports center is on your left, next to a small coffee shop. Who is with you? If you are alone, call me and I go to the door. See you in a minute.",
  "voice": "ellen",
  "file": "a4_listening2.mp3"
 },
 {
  "text": "Bruno waits for the bus at the corner of Fifth Street. He asks a woman where the bus stops. He buys a ticket with two coins. He leaves the bus in front of the library. He asks a man where the sports center is.",
  "voice": "ellen",
  "file": "pc_order_l4.mp3"
 },
