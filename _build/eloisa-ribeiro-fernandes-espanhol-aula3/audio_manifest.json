 },
 {
  "text": "Nadar",
  "voice": "arthur",
  "file": "a3_nadar.mp3"
 },
 {
  "text": "Caminar",
  "voice": "arthur",
  "file": "a3_caminar.mp3"
 },
 {
  "text": "Descansar",
  "voice": "arthur",
  "file": "a3_descansar.mp3"
 },
 {
  "text": "Escuchar",
  "voice": "arthur",
  "file": "a3_escuchar.mp3"
 },
 {
  "text": "Por la mañana",
  "voice": "ellen",
  "file": "a3_por_la_manana.mp3"
 },
 {
  "text": "Yo entreno por la mañana.",
  "voice": "arthur",
  "file": "a3_yo_entreno_por_la_manana.mp3"
 },
 {
  "text": "¿Tú nadas los martes?",
  "voice": "ellen",
  "file": "a3_tu_nadas_los_martes.mp3"
 },
 {
  "text": "Diego camina por el parque.",
  "voice": "arthur",
  "file": "a3_diego_camina_por_el_parque.mp3"
 },
 {
  "text": "Yo escucho música.",
  "voice": "ellen",
  "file": "a3_yo_escucho_musica.mp3"
 },
 {
  "text": "¡Muy bien, Eloisa! ¿Entrenas mucho en Brasil?",
  "voice": "arthur",
  "file": "a3_muy_bien_eloisa_entrenas_mucho_en_brasil.mp3"
 },
 {
  "text": "Sí, entreno tres días. Por la mañana.",
  "voice": "ellen",
  "file": "a3_si_entreno_tres_dias_por_la_manana.mp3"
 },
 {
  "text": "¿Y nadas también?",
  "voice": "arthur",
  "file": "a3_y_nadas_tambien.mp3"
 },
 {
  "text": "Sí, nado los martes.",
  "voice": "ellen",
  "file": "a3_si_nado_los_martes.mp3"
 },
 {
  "text": "¿Escuchas música cuando corres?",
  "voice": "arthur",
  "file": "a3_escuchas_musica_cuando_corres.mp3"
 },
 {
  "text": "Sí, escucho música siempre.",
  "voice": "ellen",
  "file": "a3_si_escucho_musica_siempre.mp3"
 },
 {
  "text": "Yo no. Yo escucho la ciudad.",
  "voice": "arthur",
  "file": "a3_yo_no_yo_escucho_la_ciudad.mp3"
 },
 {
  "text": "¿Y el domingo? ¿Entrenas?",
  "voice": "ellen",
  "file": "a3_y_el_domingo_entrenas.mp3"
 },
 {
  "text": "No. El domingo descanso y camino un poco.",
  "voice": "arthur",
  "file": "a3_no_el_domingo_descanso_y_camino_un_poco.mp3"
 },
 {
  "text": "¡Buena idea!",
  "voice": "ellen",
  "file": "a3_buena_idea.mp3"
 },
 {
  "text": "Entreno por la mañana.",
  "voice": "arthur",
  "file": "a3_entreno_por_la_manana.mp3"
 },
 {
  "text": "Nado los martes.",
  "voice": "ellen",
  "file": "a3_nado_los_martes.mp3"
 },
 {
  "text": "Escucho música cuando corro.",
  "voice": "arthur",
  "file": "a3_escucho_musica_cuando_corro.mp3"
 },
 {
  "text": "El domingo descanso.",
  "voice": "ellen",
  "file": "a3_el_domingo_descanso.mp3"
 },
 {
  "text": "¿Y tú? ¿Entrenas?",
  "voice": "arthur",
  "file": "a3_y_tu_entrenas.mp3"
 },
 {
  "text": "Hola, soy Carmen. Yo entreno por la mañana. Corro en el parque del Retiro. Los martes nado en la piscina del club. No escucho música cuando corro. El domingo descanso.",
  "voice": "ellen",
  "file": "a3_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. Mañana no entrenamos en el parque. Caminamos por la ciudad: es un día de descanso. El jueves, nado con Carmen en la piscina. ¿Nadas con nosotros?",
  "voice": "arthur",
  "file": "a3_listening2.mp3"
 },
 {
  "text": "Eloisa corre con el club en el parque. Diego pregunta: «¿Entrenas mucho?». Eloisa dice: «Entreno tres días». Eloisa dice: «Nado los martes». Diego dice: «El domingo descanso». Eloisa dice: «¡Buena idea!».",
  "voice": "ellen",
  "file": "pc_order_l3.mp3"
 },
