 },
 {
  "text": "Hay cuatro facturas. Dos en euros y dos en dólares.",
  "voice": "ellen",
  "file": "a4_hay_cuatro_facturas_dos_en_euros_y_dos_en_dolare.mp3"
 },
 {
  "text": "¿Cuál es el importe de la primera?",
  "voice": "arthur",
  "file": "a4_cual_es_el_importe_de_la_primera.mp3"
 },
 {
  "text": "Es de quinientos euros.",
  "voice": "ellen",
  "file": "a4_es_de_quinientos_euros.mp3"
 },
 {
  "text": "Y la segunda es de ciento cincuenta dólares.",
  "voice": "arthur",
  "file": "a4_y_la_segunda_es_de_ciento_cincuenta_dolares.mp3"
 },
 {
  "text": "¿Cuál es el tipo de cambio del ejercicio?",
  "voice": "ellen",
  "file": "a4_cual_es_el_tipo_de_cambio_del_ejercicio.mp3"
 },
 {
  "text": "Cero coma noventa y dos euros por dólar.",
  "voice": "arthur",
  "file": "a4_cero_coma_noventa_y_dos_euros_por_dolar.mp3"
 },
 {
  "text": "En mi trabajo, el pago en otra moneda es mi área.",
  "voice": "ellen",
  "file": "a4_en_mi_trabajo_el_pago_en_otra_moneda_es_mi_area.mp3"
 },
 {
  "text": "¡Perfecto! Y el saldo del banco, ¿es positivo?",
