    "listenings": [
      {
        "file": "a21_listening1.mp3",
        "voice": "arthur",
        "text": "Hola, Juliana, soy Diego. Te cuento de mi oficina nueva. Es más grande que la oficina antigua y tiene más luz. Está más cerca de mi casa: ahora camino quince minutos. El barrio es más tranquilo, pero los restaurantes son más caros. El edificio es tan moderno como tu oficina en São Paulo. ¡Ven a verla el próximo año! Un abrazo."
      },
      {
        "file": "a21_listening2.mp3",
        "voice": "ellen",
        "text": "Hola, Juliana, soy María, de la UPAV. ¡Qué bueno conocerte en Madrid! Te dejo este mensaje para comparar nuestros mercados. En Buenos Aires, los inmuebles son menos caros que en Madrid, pero el mercado es más lento. Las oficinas antiguas son más baratas que las modernas. ¿Y en São Paulo? ¿Los precios son tan altos como en Madrid? Hablamos en la reunión del jueves. Un abrazo."
      }
    ],
    "extra_audio": [
      {
        "key": "[order-l21]",
        "file": "pc_order_l21.mp3",
        "voice": "ellen",
        "text": "Juliana vuelve de Madrid a São Paulo. El primer día hay mucho tráfico. Ella piensa: São Paulo es más ruidosa que Madrid. Por la tarde, Diego la llama. Diego dice: Madrid es tan cara como São Paulo. Juliana quiere volver a Madrid el próximo año."
      }
    ]
  },
