 {
  "text": "Good morning. Are you Bruno?",
  "voice": "ellen",
  "file": "a2_good_morning_are_you_bruno.mp3"
 },
 {
  "text": "Yes, I am. Good morning.",
  "voice": "arthur",
  "file": "a2_yes_i_am_good_morning.mp3"
 },
 {
  "text": "Nice to meet you. I am Coach Parker. Is this your first camp?",
  "voice": "ellen",
  "file": "a2_nice_to_meet_you_i_am_coach_parker_is_this_your.mp3"
 },
 {
  "text": "Yes, it is. I am not from here. I am from Brazil.",
  "voice": "arthur",
  "file": "a2_yes_it_is_i_am_not_from_here_i_am_from_brazil.mp3"
 },
 {
  "text": "Brazil! Great. Is your family here with you?",
  "voice": "ellen",
  "file": "a2_brazil_great_is_your_family_here_with_you.mp3"
 },
 {
  "text": "My mother is here. My father is not. He is at work in Brazil.",
  "voice": "arthur",
  "file": "a2_my_mother_is_here_my_father_is_not_he_is_at_work.mp3"
 },
 {
  "text": "OK. Your group is group two, with Tyler. He is your roommate.",
  "voice": "ellen",
  "file": "a2_ok_your_group_is_group_two_with_tyler_he_is_your.mp3"
 },
 {
  "text": "Thank you. Is he Brazilian too?",
  "voice": "arthur",
  "file": "a2_thank_you_is_he_brazilian_too.mp3"
 },
 {
  "text": "No, he is not. He is from Los Angeles. Come with me.",
  "voice": "ellen",
  "file": "a2_no_he_is_not_he_is_from_los_angeles_come_with_me.mp3"
 },
 {
  "text": "Yes, I am. Nice to meet you.",
  "voice": "ellen",
  "file": "a2_yes_i_am_nice_to_meet_you.mp3"
 },
 {
  "text": "No, I am not. I am from Brazil.",
  "voice": "arthur",
  "file": "a2_no_i_am_not_i_am_from_brazil.mp3"
 },
 {
  "text": "This is my family.",
  "voice": "ellen",
  "file": "a2_this_is_my_family.mp3"
 },
 {
  "text": "Her name is Glaucia. She is my mother.",
  "voice": "arthur",
  "file": "a2_her_name_is_glaucia_she_is_my_mother.mp3"
 },
 {
  "text": "Are you a student too?",
  "voice": "ellen",
  "file": "a2_are_you_a_student_too.mp3"
 },
 {
  "text": "Hello, this is Coach Parker from the basketball camp. I have a short message about next week. The camp is not at the school this year. We are at the city sports center, on Grand Avenue. And the first day is not Monday: it is Tuesday. Please be there at nine in the morning. Bring water and good shoes. Is your son ready? Thank you, and see you on Tuesday.",
  "voice": "ellen",
  "file": "a2_listening1.mp3"
 },
 {
  "text": "Hi Bruno, this is Tyler. I am your roommate this summer. Let me tell you about my family. My father is a doctor. His name is Robert. My mother is a teacher. Her name is Susan. She is not American. She is from Canada. I have two brothers and one sister. My sister is nine. Her name is Emma. She is not a basketball fan. My brothers are twelve and nineteen. See you on Tuesday.",
  "voice": "arthur",
  "file": "a2_listening2.mp3"
 },
 {
  "text": "Bruno opens the email from the camp. He reads the name of his coach. He reads the name of his roommate. He writes an answer to the camp. He says he is ready.",
  "voice": "ellen",
  "file": "pc_order_l2.mp3"
 },
