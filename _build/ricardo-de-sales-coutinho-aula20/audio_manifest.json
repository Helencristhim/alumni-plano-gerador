 {
  "text": "The call is on Wednesday at ten, Miami time.",
  "voice": "ellen",
  "file": "a20_the_call_is_on_wednesday_at_ten_miami_time.mp3"
 },
 {
  "text": "Good evening! Welcome to the Brickell Bay Hotel.",
  "voice": "ellen",
  "file": "a20_good_evening_welcome_to_the_brickell_bay_hotel.mp3"
 },
 {
  "text": "Good evening. My name is Ricardo Coutinho. I have a reservation.",
  "voice": "arthur",
  "file": "a20_good_evening_my_name_is_ricardo_coutinho_i_have.mp3"
 },
 {
  "text": "Yes, Mr. Coutinho. Seven nights, one room. Can I see your passport?",
  "voice": "ellen",
  "file": "a20_yes_mr_coutinho_seven_nights_one_room_can_i_see.mp3"
 },
 {
  "text": "Sure. Here it is.",
  "voice": "arthur",
  "file": "a20_sure_here_it_is.mp3"
 },
 {
  "text": "Thank you. Your room is on the twelfth floor. Here is your key.",
  "voice": "ellen",
  "file": "a20_thank_you_your_room_is_on_the_twelfth_floor_here.mp3"
 },
 {
  "text": "Thank you. Where is the elevator?",
  "voice": "arthur",
  "file": "a20_thank_you_where_is_the_elevator.mp3"
 },
 {
  "text": "It is on the left, near the café.",
  "voice": "ellen",
  "file": "a20_it_is_on_the_left_near_the_cafe.mp3"
 },
 {
  "text": "And what time is breakfast?",
  "voice": "arthur",
  "file": "a20_and_what_time_is_breakfast.mp3"
 },
 {
  "text": "Breakfast is from six to ten. Have a good night!",
  "voice": "ellen",
  "file": "a20_breakfast_is_from_six_to_ten_have_a_good_night.mp3"
 },
 {
  "text": "Thank you. Good night!",
  "voice": "arthur",
  "file": "a20_thank_you_good_night.mp3"
 },
 {
  "text": "Welcome to the Brickell Bay Hotel. Breakfast is on the second floor, from six to ten. The gym is open from five in the morning to eleven at night. The elevators are on the left, near the café. To call the reception, press zero in your room. Check-out is at twelve. Have a nice stay!",
  "voice": "ellen",
  "file": "a20_listening1.mp3"
 },
 {
  "text": "Hi, it's Paul. A small piece of advice for your first week. At the hotel, the room key is a card, not a key. Keep it in your wallet, not with your phone. In the office, people say good morning in the elevator. It's normal, and it's nice. And on a call with São Paulo, remember the time zone. Miami is one hour behind São Paulo now. So a call at ten in Miami is at eleven in São Paulo.",
  "voice": "arthur",
  "file": "a20_listening2.mp3"
 },
 {
