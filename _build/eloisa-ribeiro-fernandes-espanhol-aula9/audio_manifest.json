 },
 {
  "text": "Eloisa, ¿y tu trabajo? ¿Qué haces?",
  "voice": "arthur",
  "file": "a9_eloisa_y_tu_trabajo_que_haces.mp3"
 },
 {
  "text": "Trabajo en marketing, en una empresa brasileña.",
  "voice": "ellen",
  "file": "a9_trabajo_en_marketing_en_una_empresa_brasilena.mp3"
 },
 {
  "text": "¿Tienes una oficina grande?",
  "voice": "arthur",
  "file": "a9_tienes_una_oficina_grande.mp3"
 },
 {
  "text": "No, es pequeña. Pero tengo muchos correos.",
  "voice": "ellen",
  "file": "a9_no_es_pequena_pero_tengo_muchos_correos.mp3"
 },
 {
  "text": "¡Como todos! ¿Tienes clientes en España?",
  "voice": "arthur",
  "file": "a9_como_todos_tienes_clientes_en_espana.mp3"
 },
 {
  "text": "No, pero tenemos un proveedor en Turquía.",
  "voice": "ellen",
  "file": "a9_no_pero_tenemos_un_proveedor_en_turquia.mp3"
 },
 {
  "text": "¿En Turquía? ¿Y tienes reuniones con ellos?",
  "voice": "arthur",
  "file": "a9_en_turquia_y_tienes_reuniones_con_ellos.mp3"
 },
 {
  "text": "Sí, a veces. En inglés.",
  "voice": "ellen",
  "file": "a9_si_a_veces_en_ingles.mp3"
 },
 {
  "text": "¡Y ahora también en español!",
  "voice": "arthur",
  "file": "a9_y_ahora_tambien_en_espanol.mp3"
 },
 {
  "text": "¡Poco a poco!",
  "voice": "ellen",
  "file": "a9_poco_a_poco.mp3"
 },
 {
  "text": "Trabajo en marketing.",
  "voice": "ellen",
  "file": "a9_trabajo_en_marketing.mp3"
 },
 {
  "text": "Es una empresa brasileña.",
  "voice": "arthur",
  "file": "a9_es_una_empresa_brasilena.mp3"
 },
 {
  "text": "Tenemos un proveedor en Turquía.",
