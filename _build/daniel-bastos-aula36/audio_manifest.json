 },
 {
  "text": "El puerto es muy grande.",
  "voice": "ellen",
  "file": "a36_el_puerto_es_muy_grande.mp3"
 },
 {
  "text": "El buque está en el muelle.",
  "voice": "arthur",
  "file": "a36_el_buque_esta_en_el_muelle.mp3"
 },
 {
  "text": "El contenedor está retenido.",
  "voice": "ellen",
  "file": "a36_el_contenedor_esta_retenido.mp3"
 },
 {
  "text": "Mario es el agente de la naviera.",
  "voice": "arthur",
  "file": "a36_mario_es_el_agente_de_la_naviera.mp3"
 },
 {
  "text": "Ya he hablado con el puerto.",
  "voice": "ellen",
  "file": "a36_ya_he_hablado_con_el_puerto.mp3"
 },
 {
  "text": "Todavía no hemos recibido la confirmación.",
  "voice": "arthur",
  "file": "a36_todavia_no_hemos_recibido_la_confirmacion.mp3"
 },
 {
  "text": "¿Has visto el manifiesto?",
  "voice": "ellen",
  "file": "a36_has_visto_el_manifiesto.mp3"
 },
 {
  "text": "Mario ya ha hecho el trámite.",
  "voice": "arthur",
  "file": "a36_mario_ya_ha_hecho_el_tramite.mp3"
 },
 {
  "text": "Todavía no hemos recibido la confirmación del puerto.",
  "voice": "ellen",
  "file": "a36_todavia_no_hemos_recibido_la_confirmacion_del_pu.mp3"
 },
 {
  "text": "Ya he hablado con la naviera.",
  "voice": "arthur",
  "file": "a36_ya_he_hablado_con_la_naviera.mp3"
 },
 {
  "text": "El contenedor está retenido en la aduana.",
  "voice": "ellen",
  "file": "a36_el_contenedor_esta_retenido_en_la_aduana.mp3"
 },
 {
  "text": "Le aviso lo antes posible.",
  "voice": "arthur",
  "file": "a36_le_aviso_lo_antes_posible.mp3"
 },
 {
  "text": "Lamentamos la demora, que fue inevitable.",
  "voice": "ellen",
  "file": "a36_lamentamos_la_demora_que_fue_inevitable.mp3"
 },
 {
  "text": "Buenos días, señor Bastos, habla Mario Vega, de la naviera. Ya hemos reprogramado la salida: el buque zarpa el viernes a las seis de la mañana. Su contenedor está en la bodega tres y ya hemos entregado el manifiesto a la aduana. Todavía no hemos recibido la autorización. Si necesita tramitar un documento, venga al muelle a más tardar el miércoles. Gracias.",
  "voice": "arthur",
  "file": "a36_listening1.mp3"
 },
