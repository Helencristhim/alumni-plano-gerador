 },
 {
  "text": "It's raining a lot.",
  "voice": "arthur",
  "file": "a27_it_s_raining_a_lot.mp3"
 },
 {
  "text": "They're boarding the London flight.",
  "voice": "ellen",
  "file": "a27_they_re_boarding_the_london_flight.mp3"
 },
 {
  "text": "What are you doing?",
  "voice": "arthur",
  "file": "a27_what_are_you_doing.mp3"
 },
 {
  "text": "I'm waiting.",
  "voice": "arthur",
  "file": "a27_i_m_waiting.mp3"
 },
 {
  "text": "It's raining.",
  "voice": "arthur",
  "file": "a27_it_s_raining.mp3"
 },
 {
  "text": "They're boarding now.",
  "voice": "ellen",
  "file": "a27_they_re_boarding_now.mp3"
 },
 {
  "text": "Hi! Where are you? What are you doing?",
  "voice": "ellen",
  "file": "a27_hi_where_are_you_what_are_you_doing.mp3"
 },
 {
  "text": "I'm standing in a long line at security. It's moving very slowly.",
  "voice": "arthur",
  "file": "a27_i_m_standing_in_a_long_line_at_security_it_s_mov.mp3"
 },
 {
  "text": "Oh no. I'm sitting in a café near gate nine. I'm having a coffee.",
  "voice": "ellen",
  "file": "a27_oh_no_i_m_sitting_in_a_cafe_near_gate_nine_i_m_h.mp3"
 },
 {
  "text": "Lucky you! Is it still raining outside?",
  "voice": "arthur",
  "file": "a27_lucky_you_is_it_still_raining_outside.mp3"
 },
 {
  "text": "Yes, it's raining a lot. And look at the board: our flight is delayed.",
  "voice": "ellen",
  "file": "a27_yes_it_s_raining_a_lot_and_look_at_the_board_our.mp3"
 },
 {
  "text": "Really? How late?",
  "voice": "arthur",
  "file": "a27_really_how_late.mp3"
 },
 {
  "text": "One hour. The new time is two forty.",
  "voice": "ellen",
  "file": "a27_one_hour_the_new_time_is_two_forty.mp3"
 },
 {
  "text": "OK, good. So I'm not running. And what are you doing now?",
  "voice": "arthur",
  "file": "a27_ok_good_so_i_m_not_running_and_what_are_you_doin.mp3"
 },
 {
  "text": "I'm watching the planes. And I'm shopping for chocolate for your wife!",
  "voice": "ellen",
  "file": "a27_i_m_watching_the_planes_and_i_m_shopping_for_cho.mp3"
 },
 {
  "text": "She'll love it. Oh, wait. My wife is calling me now.",
  "voice": "arthur",
  "file": "a27_she_ll_love_it_oh_wait_my_wife_is_calling_me_now.mp3"
 },
 {
  "text": "Tell her we're waiting, and everything is OK.",
  "voice": "ellen",
  "file": "a27_tell_her_we_re_waiting_and_everything_is_ok.mp3"
 },
 {
  "text": "I will. The line is moving. See you at the gate in twenty minutes!",
  "voice": "arthur",
  "file": "a27_i_will_the_line_is_moving_see_you_at_the_gate_in.mp3"
 },
 {
  "text": "I'm waiting at the gate.",
  "voice": "arthur",
  "file": "a27_i_m_waiting_at_the_gate.mp3"
 },
 {
  "text": "It's raining a lot here.",
  "voice": "ellen",
  "file": "a27_it_s_raining_a_lot_here.mp3"
 },
 {
  "text": "Our flight is delayed.",
  "voice": "arthur",
  "file": "a27_our_flight_is_delayed.mp3"
 },
 {
  "text": "Good afternoon, ladies and gentlemen. This is an announcement for passengers on the flight to London. We are now boarding at gate twelve. Passengers with small children, please come to the front of the line. Passengers on the flight to Lisbon: we are sorry, your flight is delayed. The new departure time is fourteen forty. Our team is cleaning the plane now. It is raining a lot in Oslo today, and some flights are leaving late. Please check the departure board. Thank you, and have a good flight.",
  "voice": "ellen",
  "file": "a27_listening1.mp3"
 },
 {
  "text": "Hi, honey, it's me. I'm sitting on the plane now, seat fourteen C. We're waiting for the last passengers. The man next to me is already sleeping! The flight attendants are closing the doors, and the captain is talking. It's still raining here, but he says the weather in Lisbon is sunny. Claire is sitting two rows behind me. She's reading a book. I'm turning off my phone now. See you tomorrow morning. Love you. Bye!",
  "voice": "arthur",
  "file": "a27_listening2.mp3"
 },
 {
  "text": "I'm standing in a long line at security. My phone is ringing. It is Claire. She's sitting in a cafe, and she's having a coffee. It's raining, and our flight is delayed. Now the line is moving, and I'm walking to the gate.",
  "voice": "arthur",
  "file": "pc_order_l27.mp3"
 },
