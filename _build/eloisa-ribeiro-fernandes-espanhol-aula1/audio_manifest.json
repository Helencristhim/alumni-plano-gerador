 },
 {
  "text": "Me llamo Eloisa. Encantada.",
  "voice": "ellen",
  "file": "a1_me_llamo_eloisa_encantada.mp3"
 },
 {
  "text": "Encantado, Eloisa. ¿Eres de España?",
  "voice": "arthur",
  "file": "a1_encantado_eloisa_eres_de_espana.mp3"
 },
 {
  "text": "No, soy de Brasil. Soy brasileña.",
  "voice": "ellen",
  "file": "a1_no_soy_de_brasil_soy_brasilena.mp3"
 },
 {
  "text": "¿De qué ciudad?",
  "voice": "arthur",
