 },
 {
  "text": "Soy de Santo André. ¿Y tú?",
  "voice": "ellen",
  "file": "a1_soy_de_santo_andre_y_tu.mp3"
 },
 {
  "text": "Yo soy de Madrid. Soy entrenador.",
  "voice": "arthur",
  "file": "a1_yo_soy_de_madrid_soy_entrenador.mp3"
 },
 {
  "text": "¡Qué bien! Hasta mañana, Diego.",
