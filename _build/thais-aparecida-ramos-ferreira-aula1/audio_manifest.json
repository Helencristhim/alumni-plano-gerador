 },
 {
  "text": "Good evening. Welcome to the hotel. Can I help you?",
  "voice": "arthur",
  "file": "a1_good_evening_welcome_to_the_hotel_can_i_help_you.mp3"
 },
 {
  "text": "Yes, please. My name is Thaís Ferreira.",
  "voice": "ellen",
  "file": "a1_yes_please_my_name_is_thais_ferreira.mp3"
 },
 {
  "text": "Nice to meet you. Where are you from?",
  "voice": "arthur",
  "file": "a1_nice_to_meet_you_where_are_you_from.mp3"
 },
 {
  "text": "I am from Brazil. I live in São Paulo, a very big city.",
  "voice": "ellen",
  "file": "a1_i_am_from_brazil_i_live_in_sao_paulo_a_very_big.mp3"
 },
 {
  "text": "Very good. Is this your first time in Paris?",
  "voice": "arthur",
  "file": "a1_very_good_is_this_your_first_time_in_paris.mp3"
 },
 {
  "text": "Yes. This trip is for my daughter. She is fifteen today.",
  "voice": "ellen",
  "file": "a1_yes_this_trip_is_for_my_daughter_she_is_fifteen.mp3"
 },
 {
  "text": "Happy birthday to her. Do you need anything tonight?",
  "voice": "arthur",
  "file": "a1_happy_birthday_to_her_do_you_need_anything_tonig.mp3"
 },
 {
  "text": "I need a map, please. And where is the metro?",
  "voice": "ellen",
  "file": "a1_i_need_a_map_please_and_where_is_the_metro.mp3"
 },
 {
  "text": "It is very close. Two minutes from the door, on the left.",
  "voice": "arthur",
  "file": "a1_it_is_very_close_two_minutes_from_the_door_on_th.mp3"
 },
 {
  "text": "Thank you. Can you help me with the bags?",
  "voice": "ellen",
  "file": "a1_thank_you_can_you_help_me_with_the_bags.mp3"
 },
 {
  "text": "Good afternoon, and welcome to Paris. Passengers from São Paulo, please follow the signs to passport control. After passport control, go down to level one for your bags. The taxi is outside, on the left. The train to the city is outside too, on the right. Please keep your passport in your hand. Thank you, and welcome to France.",
  "voice": "arthur",
  "file": "a1_listening1.mp3"
 },
 {
  "text": "Hello, this is a message from the hotel in Paris. Your room is ready for October first. It is a room for three people, with one big bed and one small bed. Breakfast is from seven to ten in the morning. If you need help, please call the front desk. We speak English. See you very soon, and have a good trip.",
  "voice": "ellen",
  "file": "a1_listening2.mp3"
 },
 {
  "text": "Thaís arrives at the hotel in Paris. She says her name to the man at the desk. She says she is from Brazil. She asks where the metro is. She asks for help with the bags.",
  "voice": "ellen",
  "file": "pc_order_l1.mp3"
 },
