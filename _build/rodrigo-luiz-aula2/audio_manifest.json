 {
  "text": "Our factory is here in Brazil.",
  "voice": "ellen",
  "file": "a2_our_factory_is_here_in_brazil.mp3"
 },
 {
  "text": "My team runs the full supply chain.",
  "voice": "arthur",
  "file": "a2_my_team_runs_the_full_supply_chain.mp3"
 },
 {
  "text": "I work in operations.",
  "voice": "ellen",
  "file": "a2_i_work_in_operations.mp3"
 },
 {
  "text": "He works in purchasing.",
  "voice": "arthur",
  "file": "a2_he_works_in_purchasing.mp3"
 },
 {
  "text": "She sends the product to the client.",
  "voice": "ellen",
