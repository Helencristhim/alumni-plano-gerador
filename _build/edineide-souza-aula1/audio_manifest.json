 },
 {
  "text": "¿Tú eres la coordinadora?",
  "voice": "ellen",
  "file": "a1_tu_eres_la_coordinadora.mp3"
 },
 {
  "text": "Hola, buenos días. Soy Pablo Ortega.",
  "voice": "arthur",
  "file": "a1_hola_buenos_dias_soy_pablo_ortega.mp3"
 },
 {
  "text": "Hola, Pablo. Soy Edineide Souza. ¡Encantada!",
  "voice": "ellen",
  "file": "a1_hola_pablo_soy_edineide_souza_encantada.mp3"
 },
 {
  "text": "Encantado, Edineide. ¿Eres de Brasil?",
  "voice": "arthur",
  "file": "a1_encantado_edineide_eres_de_brasil.mp3"
 },
 {
  "text": "Sí, soy brasileña. ¿Y tú?",
  "voice": "ellen",
  "file": "a1_si_soy_brasilena_y_tu.mp3"
 },
 {
  "text": "Soy español, de Madrid. Soy analista de tesorería.",
  "voice": "arthur",
  "file": "a1_soy_espanol_de_madrid_soy_analista_de_tesoreria.mp3"
 },
 {
  "text": "¡Qué bien! Yo soy coordinadora de tesorería.",
  "voice": "ellen",
  "file": "a1_que_bien_yo_soy_coordinadora_de_tesoreria.mp3"
 },
 {
  "text": "¿Y tu empresa? ¿Es brasileña?",
  "voice": "arthur",
  "file": "a1_y_tu_empresa_es_brasilena.mp3"
 },
 {
  "text": "No, es italiana. Es una empresa farmacéutica.",
  "voice": "ellen",
  "file": "a1_no_es_italiana_es_una_empresa_farmaceutica.mp3"
 },
 {
  "text": "Mi equipo es pequeño: somos tres.",
  "voice": "arthur",
  "file": "a1_mi_equipo_es_pequeno_somos_tres.mp3"
 },
 {
  "text": "¡Muy bien! Hasta el jueves, Pablo.",
  "voice": "ellen",
  "file": "a1_muy_bien_hasta_el_jueves_pablo.mp3"
 },
 {
  "text": "Me llamo Edineide.",
  "voice": "arthur",
  "file": "a1_me_llamo_edineide.mp3"
 },
 {
  "text": "Soy coordinadora de tesorería.",
  "voice": "ellen",
  "file": "a1_soy_coordinadora_de_tesoreria.mp3"
 },
 {
  "text": "Trabajo en una empresa farmacéutica.",
  "voice": "arthur",
  "file": "a1_trabajo_en_una_empresa_farmaceutica.mp3"
 },
 {
  "text": "Encantada de conocerte.",
  "voice": "ellen",
  "file": "a1_encantada_de_conocerte.mp3"
 },
 {
  "text": "Hola, me llamo Lucía Martín. Soy española, de Sevilla. Soy directora financiera en una empresa de Madrid. Mi empresa es grande. Mi equipo es de cinco personas. Somos un equipo muy bueno. ¡Hasta pronto!",
  "voice": "ellen",
  "file": "a1_listening1.mp3"
 },
 {
  "text": "Hola, Edineide, soy Pablo. Gracias por la clase de hoy. Te presento a mi equipo. Marta es analista y es de Valencia. Luis es contable y es de Bilbao. Ellos son muy simpáticos. ¡Hasta el jueves!",
  "voice": "arthur",
  "file": "a1_listening2.mp3"
 },
 {
  "text": "Edineide empieza un curso online de finanzas. Pablo dice: «Hola, soy Pablo Ortega». Edineide responde: «Encantada, soy Edineide». Pablo es analista de tesorería en Madrid. Edineide es coordinadora en una empresa farmacéutica. Pablo y Edineide son colegas del curso.",
  "voice": "ellen",
  "file": "pc_order_l1.mp3"
 },
