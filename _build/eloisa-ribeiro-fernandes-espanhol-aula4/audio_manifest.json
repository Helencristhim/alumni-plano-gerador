 },
 {
  "text": "La hora",
  "voice": "arthur",
  "file": "a4_la_hora.mp3"
 },
 {
  "text": "El kilómetro",
  "voice": "arthur",
  "file": "a4_el_kilometro.mp3"
 },
 {
  "text": "Temprano",
  "voice": "arthur",
  "file": "a4_temprano.mp3"
 },
 {
  "text": "La carrera es el domingo.",
  "voice": "arthur",
  "file": "a4_la_carrera_es_el_domingo.mp3"
 },
 {
  "text": "Es a las nueve.",
  "voice": "ellen",
  "file": "a4_es_a_las_nueve.mp3"
 },
 {
  "text": "Son diez kilómetros.",
  "voice": "arthur",
  "file": "a4_son_diez_kilometros.mp3"
 },
 {
  "text": "Nado a la una.",
  "voice": "ellen",
  "file": "a4_nado_a_la_una.mp3"
 },
 {
  "text": "Eloisa, ¿corres la carrera del domingo?",
  "voice": "arthur",
  "file": "a4_eloisa_corres_la_carrera_del_domingo.mp3"
 },
 {
  "text": "¿A qué hora es?",
  "voice": "ellen",
  "file": "a4_a_que_hora_es.mp3"
 },
 {
  "text": "A las nueve. Es temprano.",
  "voice": "arthur",
  "file": "a4_a_las_nueve_es_temprano.mp3"
 },
 {
  "text": "Perfecto. ¿Cuántos kilómetros?",
  "voice": "ellen",
  "file": "a4_perfecto_cuantos_kilometros.mp3"
 },
 {
  "text": "Cinco o diez. ¿Cinco?",
  "voice": "arthur",
  "file": "a4_cinco_o_diez_cinco.mp3"
 },
 {
  "text": "No, diez. ¡Corro diez!",
  "voice": "ellen",
  "file": "a4_no_diez_corro_diez.mp3"
 },
 {
  "text": "¡Muy bien! ¿Y el lunes? ¿Nadas?",
  "voice": "arthur",
  "file": "a4_muy_bien_y_el_lunes_nadas.mp3"
 },
 {
  "text": "Sí, el lunes nado a la una.",
  "voice": "ellen",
  "file": "a4_si_el_lunes_nado_a_la_una.mp3"
 },
 {
  "text": "Una semana con mucho deporte.",
  "voice": "arthur",
  "file": "a4_una_semana_con_mucho_deporte.mp3"
 },
 {
  "text": "Sí, y el fin de semana también.",
  "voice": "ellen",
  "file": "a4_si_y_el_fin_de_semana_tambien.mp3"
 },
 {
  "text": "¿A qué hora es la carrera?",
  "voice": "arthur",
  "file": "a4_a_que_hora_es_la_carrera.mp3"
 },
 {
  "text": "El lunes nado.",
  "voice": "ellen",
  "file": "a4_el_lunes_nado.mp3"
 },
 {
  "text": "Corro diez kilómetros.",
  "voice": "arthur",
  "file": "a4_corro_diez_kilometros.mp3"
 },
 {
  "text": "El fin de semana descanso.",
  "voice": "ellen",
  "file": "a4_el_fin_de_semana_descanso.mp3"
 },
 {
  "text": "Hola, soy Carmen. El lunes y el miércoles corro a las siete. El martes nado a la una. El jueves entreno en el gimnasio. El fin de semana corro doce kilómetros.",
  "voice": "ellen",
  "file": "a4_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. La carrera es el domingo a las nueve. Tu número es el quince. El sábado, a las cinco, entregamos las camisetas en el club. ¡Hasta el sábado!",
  "voice": "arthur",
  "file": "a4_listening2.mp3"
 },
 {
  "text": "Diego invita a Eloisa a una carrera. Eloisa pregunta: «¿A qué hora es?». Diego dice: «A las nueve». Eloisa dice: «Corro diez kilómetros». El sábado, Eloisa va al club. El domingo, Eloisa corre la carrera.",
  "voice": "ellen",
  "file": "pc_order_l4.mp3"
 },
