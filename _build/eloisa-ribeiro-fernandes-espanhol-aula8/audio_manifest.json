 },
 {
  "text": "Me gusta viajar.",
  "voice": "ellen",
  "file": "a8_me_gusta_viajar.mp3"
 },
 {
  "text": "Me gusta la comida española.",
  "voice": "arthur",
  "file": "a8_me_gusta_la_comida_espanola.mp3"
 },
 {
  "text": "Me gustan las ciudades grandes.",
  "voice": "ellen",
  "file": "a8_me_gustan_las_ciudades_grandes.mp3"
 },
 {
  "text": "No me gusta la playa.",
  "voice": "arthur",
  "file": "a8_no_me_gusta_la_playa.mp3"
 },
 {
  "text": "Eloisa, ¿te gusta viajar?",
  "voice": "arthur",
  "file": "a8_eloisa_te_gusta_viajar.mp3"
 },
 {
  "text": "¡Sí! Me gusta mucho. Me gusta conocer ciudades.",
  "voice": "ellen",
  "file": "a8_si_me_gusta_mucho_me_gusta_conocer_ciudades.mp3"
 },
 {
  "text": "¿Y qué te gusta de una ciudad?",
  "voice": "arthur",
  "file": "a8_y_que_te_gusta_de_una_ciudad.mp3"
 },
 {
  "text": "Me gusta la cultura y me gusta la comida.",
  "voice": "ellen",
  "file": "a8_me_gusta_la_cultura_y_me_gusta_la_comida.mp3"
 },
 {
  "text": "¿Y la playa?",
  "voice": "arthur",
  "file": "a8_y_la_playa.mp3"
 },
 {
  "text": "Sí, pero me gustan más las ciudades grandes.",
  "voice": "ellen",
  "file": "a8_si_pero_me_gustan_mas_las_ciudades_grandes.mp3"
 },
 {
  "text": "A mí me gusta la montaña. Me gusta correr en la montaña.",
  "voice": "arthur",
  "file": "a8_a_mi_me_gusta_la_montana_me_gusta_correr_en_la_m.mp3"
 },
 {
  "text": "¿En la montaña? ¡Qué difícil!",
  "voice": "ellen",
  "file": "a8_en_la_montana_que_dificil.mp3"
 },
 {
  "text": "Sí, pero me gusta. ¿Y a ti qué no te gusta?",
  "voice": "arthur",
  "file": "a8_si_pero_me_gusta_y_a_ti_que_no_te_gusta.mp3"
 },
 {
  "text": "No me gusta el avión. ¡Es muy largo!",
  "voice": "ellen",
  "file": "a8_no_me_gusta_el_avion_es_muy_largo.mp3"
 },
 {
  "text": "Me gusta mucho viajar.",
  "voice": "ellen",
  "file": "a8_me_gusta_mucho_viajar.mp3"
 },
 {
  "text": "Me gusta conocer ciudades.",
  "voice": "arthur",
  "file": "a8_me_gusta_conocer_ciudades.mp3"
 },
 {
  "text": "Me gustan los museos.",
  "voice": "ellen",
  "file": "a8_me_gustan_los_museos.mp3"
 },
 {
  "text": "¿Y a ti? ¿Te gusta viajar?",
  "voice": "arthur",
  "file": "a8_y_a_ti_te_gusta_viajar.mp3"
 },
 {
  "text": "Hola, soy Carmen. Hoy hablo de mis viajes. Me gusta mucho Londres: me gustan los parques y los museos. También me gusta Lisboa, por la comida. No me gusta viajar en verano: no me gusta el calor.",
  "voice": "ellen",
  "file": "a8_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. Este sábado el club va a la montaña, a la sierra de Madrid. Corremos diez kilómetros y después hay comida típica. Te gusta conocer culturas, ¿no? ¡Te espero!",
  "voice": "arthur",
  "file": "a8_listening2.mp3"
 },
 {
  "text": "Diego pregunta: «¿Te gusta viajar?». Eloisa dice: «Me gusta conocer ciudades». Eloisa dice: «Me gustan las ciudades grandes». Diego dice: «Me gusta la montaña». Diego pregunta: «¿Qué no te gusta?». Eloisa dice: «No me gusta el avión».",
  "voice": "ellen",
  "file": "pc_order_l8.mp3"
 },
