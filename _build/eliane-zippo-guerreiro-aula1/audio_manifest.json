 },
 {
  "text": "Perfect. It is okay under the seat. The flight is eight hours.",
  "voice": "arthur",
  "file": "a1_perfect_it_is_okay_under_the_seat_the_flight_is.mp3"
 },
 {
  "text": "Okay. Miami is my second home.",
