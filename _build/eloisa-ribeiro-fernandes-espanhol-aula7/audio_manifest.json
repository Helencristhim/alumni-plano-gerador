 },
 {
  "text": "Estoy nerviosa.",
  "voice": "arthur",
  "file": "a7_estoy_nerviosa.mp3"
 },
 {
  "text": "¿Cómo estás?",
  "voice": "arthur",
  "file": "a7_como_estas.mp3"
 },
 {
  "text": "Diego está tranquilo.",
  "voice": "ellen",
  "file": "a7_diego_esta_tranquilo.mp3"
 },
 {
  "text": "Carmen está cansada.",
  "voice": "arthur",
  "file": "a7_carmen_esta_cansada.mp3"
 },
 {
  "text": "Eloisa, ¿cómo estás?",
  "voice": "arthur",
  "file": "a7_eloisa_como_estas.mp3"
 },
 {
  "text": "Estoy un poco nerviosa. ¿Y tú?",
  "voice": "ellen",
  "file": "a7_estoy_un_poco_nerviosa_y_tu.mp3"
 },
 {
  "text": "Yo estoy tranquilo. Es una carrera popular.",
  "voice": "arthur",
  "file": "a7_yo_estoy_tranquilo_es_una_carrera_popular.mp3"
 },
 {
  "text": "Sí... ¡Vamos!",
  "voice": "ellen",
  "file": "a7_si_vamos.mp3"
 },
 {
  "text": "¡Diez kilómetros! ¿Cómo estás ahora?",
  "voice": "arthur",
  "file": "a7_diez_kilometros_como_estas_ahora.mp3"
 },
 {
  "text": "Estoy muy cansada, pero estoy contenta.",
  "voice": "ellen",
  "file": "a7_estoy_muy_cansada_pero_estoy_contenta.mp3"
 },
 {
  "text": "¿Estás estresada?",
  "voice": "arthur",
  "file": "a7_estas_estresada.mp3"
 },
 {
  "text": "No, ahora estoy relajada. Correr es mi terapia.",
  "voice": "ellen",
  "file": "a7_no_ahora_estoy_relajada_correr_es_mi_terapia.mp3"
 },
 {
  "text": "¡Qué bien! Carmen está cansada también.",
  "voice": "arthur",
  "file": "a7_que_bien_carmen_esta_cansada_tambien.mp3"
 },
 {
  "text": "¡Todos estamos cansados y contentos!",
  "voice": "ellen",
  "file": "a7_todos_estamos_cansados_y_contentos.mp3"
 },
 {
  "text": "Estoy un poco nerviosa.",
  "voice": "ellen",
  "file": "a7_estoy_un_poco_nerviosa.mp3"
 },
 {
  "text": "Estoy cansada, pero contenta.",
  "voice": "arthur",
  "file": "a7_estoy_cansada_pero_contenta.mp3"
 },
 {
  "text": "Ahora estoy relajada.",
  "voice": "ellen",
  "file": "a7_ahora_estoy_relajada.mp3"
 },
 {
  "text": "Correr es mi terapia.",
  "voice": "arthur",
  "file": "a7_correr_es_mi_terapia.mp3"
 },
 {
  "text": "Hola, soy Carmen. La carrera es muy bonita. Ahora estoy cansada, pero estoy muy contenta. Antes de correr estoy nerviosa siempre. Después de correr estoy relajada. Correr es bueno para la cabeza.",
  "voice": "ellen",
  "file": "a7_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. ¿Cómo estás hoy? ¿Estás cansada? Hoy no entrenamos: el club descansa. Yo estoy muy contento con la carrera. Tu tiempo es muy bueno. ¡Felicidades!",
  "voice": "arthur",
  "file": "a7_listening2.mp3"
 },
 {
  "text": "Es domingo: el día de la carrera. Diego pregunta: «¿Cómo estás?». Eloisa dice: «Estoy nerviosa». Diego dice: «Yo estoy tranquilo». Después de diez kilómetros, Eloisa está cansada. Eloisa dice: «Correr es mi terapia».",
  "voice": "ellen",
  "file": "pc_order_l7.mp3"
 },
