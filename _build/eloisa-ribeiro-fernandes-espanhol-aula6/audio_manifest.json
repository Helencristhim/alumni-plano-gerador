 },
 {
  "text": "Eloisa, ¿dónde corres en Nueva York?",
  "voice": "arthur",
  "file": "a6_eloisa_donde_corres_en_nueva_york.mp3"
 },
 {
  "text": "En Manhattan. En el norte hay un parque muy grande.",
  "voice": "ellen",
  "file": "a6_en_manhattan_en_el_norte_hay_un_parque_muy_grand.mp3"
 },
 {
  "text": "¿Y en el sur?",
  "voice": "arthur",
  "file": "a6_y_en_el_sur.mp3"
 },
 {
  "text": "En el sur hay un puente famoso.",
  "voice": "ellen",
  "file": "a6_en_el_sur_hay_un_puente_famoso.mp3"
 },
 {
  "text": "¿Corres cerca del río?",
  "voice": "arthur",
  "file": "a6_corres_cerca_del_rio.mp3"
 },
 {
  "text": "Sí, el parque del río está cerca de mi hotel.",
  "voice": "ellen",
  "file": "a6_si_el_parque_del_rio_esta_cerca_de_mi_hotel.mp3"
 },
 {
  "text": "¿Y es seguro correr en la calle?",
  "voice": "arthur",
  "file": "a6_y_es_seguro_correr_en_la_calle.mp3"
 },
 {
  "text": "Sí, y la isla es plana. ¡Perfecto para correr!",
  "voice": "ellen",
  "file": "a6_si_y_la_isla_es_plana_perfecto_para_correr.mp3"
 },
 {
  "text": "¿Hay museos también?",
  "voice": "arthur",
  "file": "a6_hay_museos_tambien.mp3"
 },
 {
  "text": "Sí, muchos. Pero yo prefiero correr.",
  "voice": "ellen",
  "file": "a6_si_muchos_pero_yo_prefiero_correr.mp3"
 },
 {
  "text": "En el centro hay un parque.",
  "voice": "ellen",
  "file": "a6_en_el_centro_hay_un_parque.mp3"
 },
 {
  "text": "El puente está en el sur.",
  "voice": "arthur",
  "file": "a6_el_puente_esta_en_el_sur.mp3"
 },
 {
  "text": "¿Dónde está el museo?",
  "voice": "ellen",
  "file": "a6_donde_esta_el_museo.mp3"
 },
 {
  "text": "Mi hotel está cerca del río.",
  "voice": "arthur",
  "file": "a6_mi_hotel_esta_cerca_del_rio.mp3"
 },
 {
  "text": "Es perfecto para correr.",
  "voice": "ellen",
  "file": "a6_es_perfecto_para_correr.mp3"
 },
 {
  "text": "Hola, soy Carmen. Yo corro en Madrid. En el centro hay un parque muy bonito: el Retiro. En el parque hay un lago. El río de Madrid se llama Manzanares. Cerca del río hay un parque largo, perfecto para correr.",
  "voice": "ellen",
  "file": "a6_listening1.mp3"
 },
 {
  "text": "Hola, Eloisa. Soy Diego. Mañana no corremos en el Retiro: corremos cerca del río. El punto de encuentro está en el puente de Segovia, a las siete. Hay agua y fruta para todos. ¡Hasta mañana!",
  "voice": "arthur",
  "file": "a6_listening2.mp3"
 },
 {
  "text": "Diego pregunta: «¿Dónde corres en Nueva York?». Eloisa dice: «En el norte hay un parque». Eloisa dice: «En el sur hay un puente». Diego pregunta por el río. Eloisa dice: «Mi hotel está cerca del río». Eloisa dice: «¡Perfecto para correr!».",
  "voice": "ellen",
  "file": "pc_order_l6.mp3"
 },
