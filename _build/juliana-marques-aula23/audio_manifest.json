 },
 {
  "text": "Estamos esperando a los colegas de México.",
  "voice": "arthur",
  "file": "a23_estamos_esperando_a_los_colegas_de_mexico.mp3"
 },
 {
  "text": "Hola, Juliana. ¿Me oyes? Estoy probando el micrófono.",
  "voice": "arthur",
  "file": "a23_hola_juliana_me_oyes_estoy_probando_el_microfono.mp3"
 },
 {
  "text": "Sí, te oigo bien. Pero no te veo. ¿Qué pasa con tu cámara?",
  "voice": "ellen",
  "file": "a23_si_te_oigo_bien_pero_no_te_veo_que_pasa_con_tu_c.mp3"
 },
 {
  "text": "Perdón, estoy conectando la cámara. ¿Y ahora?",
  "voice": "arthur",
  "file": "a23_perdon_estoy_conectando_la_camara_y_ahora.mp3"
 },
 {
  "text": "¡Ahora sí! ¿Qué estás haciendo?",
  "voice": "ellen",
  "file": "a23_ahora_si_que_estas_haciendo.mp3"
 },
 {
  "text": "Estoy leyendo el informe de María. ¿Tienes el enlace de la reunión?",
  "voice": "arthur",
  "file": "a23_estoy_leyendo_el_informe_de_maria_tienes_el_enla.mp3"
 },
 {
  "text": "Sí, ahora te escribo el enlace en el chat.",
  "voice": "ellen",
  "file": "a23_si_ahora_te_escribo_el_enlace_en_el_chat.mp3"
 },
 {
  "text": "Gracias. Mira, María está compartiendo la pantalla.",
  "voice": "arthur",
  "file": "a23_gracias_mira_maria_esta_compartiendo_la_pantalla.mp3"
 },
 {
  "text": "Sí, veo la presentación. Es sobre el congreso.",
  "voice": "ellen",
  "file": "a23_si_veo_la_presentacion_es_sobre_el_congreso.mp3"
 },
 {
  "text": "Perfecto. Estamos esperando a los colegas de México.",
  "voice": "arthur",
  "file": "a23_perfecto_estamos_esperando_a_los_colegas_de_mexi.mp3"
 },
 {
  "text": "Yo estoy preparando mis preguntas. ¡Hasta ahora!",
  "voice": "ellen",
  "file": "a23_yo_estoy_preparando_mis_preguntas_hasta_ahora.mp3"
 },
 {
  "text": "¿Me oyes bien?",
  "voice": "ellen",
  "file": "a23_me_oyes_bien.mp3"
 },
 {
  "text": "Un momento, estoy conectando la cámara.",
  "voice": "arthur",
  "file": "a23_un_momento_estoy_conectando_la_camara.mp3"
 },
 {
  "text": "Estoy compartiendo mi pantalla.",
  "voice": "ellen",
  "file": "a23_estoy_compartiendo_mi_pantalla.mp3"
 },
 {
  "text": "El enlace está en el chat.",
  "voice": "arthur",
  "file": "a23_el_enlace_esta_en_el_chat.mp3"
 },
 {
  "text": "Ahora estoy preparando un informe.",
  "voice": "ellen",
  "file": "a23_ahora_estoy_preparando_un_informe.mp3"
 },
 {
  "text": "Hola, Juliana, soy María. Te llamo porque estoy preparando la reunión virtual del jueves. Ahora estoy escribiendo la agenda. El enlace de la videollamada está en el correo. Estamos invitando a colegas de cinco países. Por favor, revisa tu cámara y tu micrófono antes de la reunión. Empezamos a las diez de la mañana, hora de Madrid. Hasta el jueves.",
  "voice": "ellen",
  "file": "a23_listening1.mp3"
 },
 {
  "text": "Juliana, soy Diego. Estoy en la videollamada, pero tengo un problema: mi pantalla no funciona bien. Ahora estoy usando el móvil. María está hablando de los precios en Buenos Aires, y Carlos, de México, está tomando notas. ¿Puedes enviarme las diapositivas después de la reunión? Gracias.",
  "voice": "arthur",
  "file": "a23_listening2.mp3"
 },
 {
  "text": "María envía el enlace de la reunión. El jueves, Juliana se conecta a las diez menos cinco. Diego está probando su micrófono. María está compartiendo su pantalla. Todos están esperando a Carlos. Carlos llega y empieza la reunión.",
  "voice": "ellen",
  "file": "pc_order_l23.mp3"
 },
